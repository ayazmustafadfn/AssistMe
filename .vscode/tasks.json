      "type": "shell",
      "command": "./gradlew installDebug && adb shell am start -n com.artsistem.assistme/.MainActivity",
      "windows": { "command": ".\\gradlew.bat installDebug ; adb shell am start -n com.artsistem.assistme/.MainActivity" },
      "problemMatcher": []
    },
    {
      "label": "Android: Temizle (clean)",
      "type": "shell",
